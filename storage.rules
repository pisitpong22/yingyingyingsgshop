rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Signed-in does NOT mean staff: sign-up is open to the public
    // (email/password + Google + Facebook), so `request.auth != null` is just
    // a stranger with an account. Team membership lives in Firestore, same
    // check as firestore.rules.
    // Mirror firestore.rules: admin identity is an email claim, so it must be
    // a verified one. Open email/password sign-up hands out tokens with
    // email_verified:false bearing any address the registrant typed; without
    // this check such a token could match a seeded admin doc and unlock the
    // staff-only writes below.
    function isTeamMember() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower()));
    }

    function isSaneImageUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Everything under uploads/ is world-readable (product photos are shown
    // to anonymous visitors) and, by default, WRITEABLE BY STAFF ONLY.
    //
    // Only the team may change or remove a file that already exists. Every
    // product photo's exact path is public — it sits in the download URL on
    // the storefront — so an open write let anyone silently replace the
    // shop's photos with anything they liked, at the same URL.
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isTeamMember();
    }

    // The one anonymous-writeable corner: photos a customer attaches to a
    // review. Storage rules OR together across matching paths, so this adds
    // public `create` on top of the staff-only rule above — and only here.
    // Anonymous uploads elsewhere under uploads/ stay closed, which keeps a
    // stranger from turning the shop's bucket into free file hosting.
    //
    // `resource == null` is load-bearing: Storage evaluates an upload over
    // an EXISTING path as `create`, not `update`, so without it this clause
    // hands anyone a way to replace any file they can name. Verified.
    //
    // update/delete are deliberately NOT granted here — the staff-only rule
    // above is the only way an existing review photo can be touched.
    match /uploads/public/{fileName} {
      allow create: if resource == null && isSaneImageUpload();
    }
  }
}
